{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 600,

  "title": {
    "text": "Where Are Australia's Protected Areas?",
    "subtitle": "Circle size represents protected area extent; colour shows IUCN management category",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitleColor": "#666666"
  },

  "projection": {
    "type": "equalEarth",
    "center": [134, -28],
    "scale": 850
  },

  "layer": [
    {
      "data": {
        "url": "data/processed/australia.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#E8E5DC",
        "stroke": "#A8A59E",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "data/processed/capad_2024_points.csv"
      },

      "transform": [
        {
          "filter": "isValid(datum.LONGITUDE) && isValid(datum.LATITUDE) && datum.GIS_AREA > 0"
        },
        {
          "filter": "datum.LONGITUDE >= 112 && datum.LONGITUDE <= 154 && datum.LATITUDE >= -44 && datum.LATITUDE <= -10"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.52,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.25
      },

      "encoding": {
        "longitude": {
          "field": "LONGITUDE",
          "type": "quantitative"
        },

        "latitude": {
          "field": "LATITUDE",
          "type": "quantitative"
        },

        "size": {
          "field": "GIS_AREA",
          "type": "quantitative",
          "title": "Protected area (ha)",
          "scale": {
            "type": "sqrt",
            "range": [3, 420]
          },
          "legend": {
            "format": ".2s",
            "title": "Protected area (ha)"
          }
        },

        "color": {
          "field": "IUCN",
          "type": "nominal",
          "title": "IUCN category",
          "scale": {
            "domain": [
              "Ia",
              "Ib",
              "II",
              "III",
              "IV",
              "V",
              "VI",
              "NA",
              "NAS",
              "NR"
            ],
            "range": [
              "#355F4C",
              "#4F7D58",
              "#6F9A69",
              "#94B978",
              "#C1C978",
              "#D4AD63",
              "#B98254",
              "#B8B5AC",
              "#D0CDC5",
              "#E0DDD6"
            ]
          },

          "legend": {
            "title": "IUCN category"
          }
        },

        "tooltip": [
          {
            "field": "NAME",
            "type": "nominal",
            "title": "Protected Area"
          },
          {
            "field": "STATE",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "TYPE",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "IUCN",
            "type": "nominal",
            "title": "IUCN Category"
          },
          {
            "field": "GOVERNANCE",
            "type": "nominal",
            "title": "Governance"
          },
          {
            "field": "GIS_AREA",
            "type": "quantitative",
            "title": "Area (ha)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#F8F6F0",

    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12,
      "symbolOpacity": 0.8
    }
  }
}