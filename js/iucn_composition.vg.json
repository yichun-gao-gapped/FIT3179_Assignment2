{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 320,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "background": "#F8F6F0",

  "title": {
    "text": "What Kind of Protection Dominates Australia?",
    "subtitle": "Share of the National Reserve System by IUCN management category",
    "anchor": "start",
    "font": "Georgia",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 11,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666",
    "offset": 10
  },

  "data": {
    "values": [
      {
        "Category": "Strict nature reserve (Ia)",
        "Percent": 9.25
      },
      {
        "Category": "Wilderness area (Ib)",
        "Percent": 2.16
      },
      {
        "Category": "National park (II)",
        "Percent": 22.80
      },
      {
        "Category": "Natural monument (III)",
        "Percent": 1.40
      },
      {
        "Category": "Habitat/species management (IV)",
        "Percent": 2.54
      },
      {
        "Category": "Protected landscape (V)",
        "Percent": 4.24
      },
      {
        "Category": "Sustainable use (VI)",
        "Percent": 57.59
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#B8C2B8"
      },

      "encoding": {
        "y": {
          "field": "Category",
          "type": "nominal",
          "sort": [
            "Strict nature reserve (Ia)",
            "Wilderness area (Ib)",
            "National park (II)",
            "Natural monument (III)",
            "Habitat/species management (IV)",
            "Protected landscape (V)",
            "Sustainable use (VI)"
          ],
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelLimit": 230
          }
        },

        "x": {
          "field": "Percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 65]
          },
          "axis": {
            "title": "Share of National Reserve System (%)",
            "values": [0, 10, 20, 30, 40, 50, 60],
            "grid": true,
            "gridColor": "#E2DFD6",
            "domain": false,
            "ticks": false
          }
        },

        "x2": {
          "datum": 0
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 100,
        "color": "#55745F",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {
        "y": {
          "field": "Category",
          "type": "nominal",
          "sort": [
            "Strict nature reserve (Ia)",
            "Wilderness area (Ib)",
            "National park (II)",
            "Natural monument (III)",
            "Habitat/species management (IV)",
            "Protected landscape (V)",
            "Sustainable use (VI)"
          ]
        },

        "x": {
          "field": "Percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 65]
          }
        },

        "tooltip": [
          {
            "field": "Category",
            "type": "nominal",
            "title": "Management category"
          },
          {
            "field": "Percent",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "calculate": "format(datum.Percent, '.1f') + '%'",
          "as": "Label"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#405947"
      },

      "encoding": {
        "y": {
          "field": "Category",
          "type": "nominal",
          "sort": [
            "Strict nature reserve (Ia)",
            "Wilderness area (Ib)",
            "National park (II)",
            "Natural monument (III)",
            "Habitat/species management (IV)",
            "Protected landscape (V)",
            "Sustainable use (VI)"
          ]
        },

        "x": {
          "field": "Percent",
          "type": "quantitative",
          "scale": {
            "domain": [0, 65]
          }
        },

        "text": {
          "field": "Label"
        }
      }
    }
  ],

  "config": {
    "font": "Arial",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia",
      "subtitleFont": "Arial"
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 10,
      "titleFontSize": 11,
      "labelColor": "#555555",
      "titleColor": "#444444"
    }
  }
}