{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 800,
  "height": 600,

  "title": {
    "text": "How Much Land Does Each State Protect?",
    "subtitle": "Share of each state or territory covered by terrestrial protected areas in CAPAD 2024",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 12,
    "subtitleColor": "#666666"
  },

  "projection": {
    "type": "equalEarth"
  },

  "data": {
    "url": "data/processed/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_50m_admin_1_states_provinces"
    }
  },

  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "data/processed/state_protection.csv"
        },
        "key": "StateName",
        "fields": [
          "STATE",
          "LandArea_ha",
          "ProtectedArea_ha",
          "ProtectedPercent"
        ]
      }
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#F8F6F0",
        "strokeWidth": 1.5
      },

      "encoding": {
        "color": {
          "field": "ProtectedPercent",
          "type": "quantitative",
          "title": "Protected land (%)",

          "scale": {
            "type": "threshold",
            "domain": [10, 20, 30, 40, 50],
            "range": [
              "#E7EEE7",
              "#C9DCCB",
              "#9FBEA4",
              "#709879",
              "#496F57",
              "#294D3A"
            ]
          },

          "legend": {
            "title": "Protected land (%)"
          }
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ProtectedPercent",
            "type": "quantitative",
            "title": "Protected land (%)",
            "format": ".1f"
          },
          {
            "field": "ProtectedArea_ha",
            "type": "quantitative",
            "title": "Protected area (ha)",
            "format": ",.0f"
          },
          {
            "field": "LandArea_ha",
            "type": "quantitative",
            "title": "Total land area (ha)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },

      "mark": {
        "type": "point",
        "filled": true,
        "size": 75,
        "color": "#294D3A",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 149.13,
            "latitude": -35.28,
            "label": "ACT  55.9% — highest share"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#294D3A"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        }
      }
    }
  ],

  "config": {
    "background": "#F8F6F0",

    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}