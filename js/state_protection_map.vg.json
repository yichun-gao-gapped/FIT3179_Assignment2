{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 500,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "background": "#f5f3ee",

  "title": {
    "text": "How Much Land Does Each State Protect?",
    "subtitle": "Share of each state or territory covered by terrestrial protected areas in CAPAD 2024",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 11,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#666666"
  },

  "data": {
    "url": "data/processed/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "ne_50m_admin_1_states_provinces"
    }
  },

  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "data/processed/state_protection.csv"
        },
        "key": "StateName",
        "fields": [
          "STATE",
          "ProtectedArea_ha",
          "ProtectedPercent"
        ]
      }
    }
  ],

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },

      "encoding": {
        "color": {
          "field": "ProtectedPercent",
          "type": "quantitative",
          "title": "Land protected (%)",
          "scale": {
            "domain": [0, 60],
            "range": [
              "#edf2eb",
              "#55745f"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Land protected (%)"
          }
        },

        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "ProtectedPercent",
            "type": "quantitative",
            "title": "Protected land (%)",
            "format": ".2f"
          },
          {
            "field": "ProtectedArea_ha",
            "type": "quantitative",
            "title": "Protected area (ha)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.STATE == 'ACT'"
        }
      ],

      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "dx": 35,
        "dy": 3,
        "color": "#405947"
      },

      "encoding": {
        "longitude": {
          "datum": 149.12
        },

        "latitude": {
          "datum": -35.30
        },

        "text": {
          "value": "ACT 55.9% — highest share"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}